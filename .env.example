# Next.js / Vercel (both are public by design; RLS protects the data)
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Server-only (no NEXT_PUBLIC_ prefix): contact address for OpenStreetMap
# services' User-Agent, used by trailhead search
OSM_CONTACT_EMAIL=you@example.com

# Supabase Edge Function secrets are set separately:
#   npx supabase secrets set OSM_CONTACT_EMAIL=... TICKETMASTER_API_KEY=...
